{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cat \"${PLUGIN_ROOT}/context/session-start.json\"",
            "commandWindows": "type \"%PLUGIN_ROOT%\\context\\session-start.json\"",
            "statusMessage": "Loading Agent Looker safety rules"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "cat \"${PLUGIN_ROOT}/context/pre-context.json\"",
            "commandWindows": "type \"%PLUGIN_ROOT%\\context\\pre-context.json\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "cat \"${PLUGIN_ROOT}/context/post-context.json\"",
            "commandWindows": "type \"%PLUGIN_ROOT%\\context\\post-context.json\""
          }
        ]
      }
    ]
  }
}
